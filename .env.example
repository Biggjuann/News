# ===========================================
# News Trading Signal System — Environment
# ===========================================
# Copy this file to .env and fill in your keys.
# Only configure the sources you want to use.

# --- Free-tier API keys ---
FINNHUB_API_KEY=your_finnhub_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FMP_API_KEY=your_fmp_key_here

# --- LLM Sentiment Scoring (for unscored headlines) ---
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Tickers (comma-separated in shell, but set as JSON list) ---
# WATCH_TICKERS=["AAPL","MSFT","SPY","ES"]

# --- Signal Thresholds ---
# BUY_SIGNAL_THRESHOLD=0.4
# SELL_SIGNAL_THRESHOLD=-0.4
# MIN_CONFIDENCE=0.6

# --- Server ---
# HOST=0.0.0.0
# PORT=8080
WEBHOOK_SECRET=change-me-in-production
